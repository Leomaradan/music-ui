# Navidrome (Subsonic API) — reachable from the app container only
SUBSONIC_URL=http://navidrome:4533
SUBSONIC_USER=music
SUBSONIC_PASSWORD=change-me

# Catalog sync check interval in minutes (0 = manual only)
SYNC_INTERVAL_MINUTES=15

# SQLite location (mount as a volume in Docker)
DATA_DIR=./data

PORT=3000
LOG_LEVEL=info

# Login screen in front of the UI (users: node scripts/cli.mjs user add <name>).
# Set to false when a reverse proxy already authenticates.
AUTH_ENABLED=true
# A session lasts this many days after the last visit
SESSION_DAYS=30
