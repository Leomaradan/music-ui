# Navidrome (Subsonic API) — reachable from the app container only
SUBSONIC_URL=http://navidrome:4533
SUBSONIC_USER=music
SUBSONIC_PASSWORD=change-me

# Catalog sync check interval in minutes (0 = manual only)
SYNC_INTERVAL_MINUTES=15

# SQLite location (mount as a volume in Docker)
DATA_DIR=./data

PORT=3000
LOG_LEVEL=info
